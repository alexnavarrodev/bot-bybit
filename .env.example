# --- Exchange (fuente de datos y, en live, ejecución) ---
# id de CCXT. Por defecto bybit. Si tu servidor está en EE.UU. (Bybit bloquea
# ese país), usa un exchange accesible desde allí como fuente de datos:
#   EXCHANGE=binanceus   -> MARKET_TYPE=spot y SYMBOLS=BTC/USDT,ETH/USDT
#   EXCHANGE=kraken      -> MARKET_TYPE=spot y SYMBOLS=BTC/USD,ETH/USD
EXCHANGE=bybit
# linear = perpetuos USDT (Bybit) | spot = mercado al contado (Binance.US, Kraken...)
MARKET_TYPE=linear

# --- Bybit API (solo necesario para operar en real en Bybit) ---
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=true
BYBIT_ACCOUNT_TYPE=linear

# --- Trading ---
# Formato de símbolo según el exchange:
#   Bybit perpetuos: BTC/USDT:USDT,ETH/USDT:USDT
#   Binance.US spot: BTC/USDT,ETH/USDT
#   Kraken spot:     BTC/USD,ETH/USD
SYMBOLS=BTC/USDT:USDT,ETH/USDT:USDT
TIMEFRAME=1h
# shadow = paper trading with real market data, no real orders
# live   = real orders on Bybit
# backtest = historical simulation only
MODE=shadow
STRATEGY=sma_crossover
RISK_PER_TRADE=0.01
LEVERAGE=1
# Capital TOTAL de la cuenta (se reparte a partes iguales entre los símbolos).
INITIAL_BALANCE=10000

# --- Database ---
# Postgres self-hosted en el VPS (docker-compose, servicio "postgres"):
POSTGRES_USER=botbybit
POSTGRES_PASSWORD=changeme
POSTGRES_DB=botbybit
DATABASE_URL=postgresql+psycopg2://botbybit:changeme@postgres:5432/botbybit

# Alternativas:
# SQLite local: DATABASE_URL=sqlite:///data/bot.db
# Supabase/Postgres externo: DATABASE_URL=postgresql+psycopg2://postgres:PASSWORD@db.xxxxx.supabase.co:5432/postgres

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Loop ---
POLL_INTERVAL_SECONDS=60

# --- Dashboard (protegido con usuario/contraseña, HTTP Basic Auth) ---
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=changeme
