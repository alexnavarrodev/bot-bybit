# --- Bybit API ---
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=true
# unified | spot | linear (perpetuals). linear = USDT perpetual futures
BYBIT_ACCOUNT_TYPE=linear

# --- Trading ---
SYMBOLS=BTC/USDT:USDT,ETH/USDT:USDT
TIMEFRAME=1h
# shadow = paper trading with real market data, no real orders
# live   = real orders on Bybit
# backtest = historical simulation only
MODE=shadow
STRATEGY=sma_crossover
RISK_PER_TRADE=0.01
LEVERAGE=1
INITIAL_BALANCE=10000

# --- Database ---
# SQLite (default, local/shadow use):
DATABASE_URL=sqlite:///data/bot.db
# Supabase / Postgres (production), example:
# DATABASE_URL=postgresql+psycopg2://postgres:PASSWORD@db.xxxxx.supabase.co:5432/postgres

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Loop ---
POLL_INTERVAL_SECONDS=60
